  },
  "dependencies": {
    "@lucide/vue": "^1.73.0",
    "@node-rs/argon2": "^2.2.2",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "nodemailer": "^10.6.0",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.6.2",
    "postgres": "^4.1.1",
    "reka-ui": "^2.11.0",
