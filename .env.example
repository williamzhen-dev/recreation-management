# Copy to .env for local development. Never commit .env.

# Seals session cookies. REQUIRED in production (>= 32 chars): openssl rand -base64 32
# In development leave it commented out and Nuxt generates one. An empty value
# (NUXT_APP_SECRET=) overrides that and breaks sign-in.
# NUXT_APP_SECRET=

# PostgreSQL 18 (local Docker container)
NUXT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/recreation_dev
# Integration tests create/migrate this database automatically
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/recreation_test

# Absolute base URL used in email links
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Email: Mailpit locally (web UI http://localhost:8025); Resend SMTP in production
# (host smtp.resend.com, port 465, secure true, user "resend", pass = API key).
# Leave NUXT_SMTP_HOST empty to print emails to the console instead.
NUXT_SMTP_HOST=localhost
NUXT_SMTP_PORT=1025
NUXT_SMTP_SECURE=false
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_EMAIL_FROM="Recreation Booking <no-reply@localhost>"

# Header set by the hosting proxy with the real client IP (production: do-connecting-ip).
NUXT_CLIENT_IP_HEADER=
